worker_processes 1;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;
    include  conf\sites-enabled\*;

    server {
        listen 80;
        server_name bcp.oasishospital.org;

        location / {
            proxy_pass         http://127.0.0.1:8080;  # <-- Updated port here
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;

        }
    }

    server {
        listen       443 ssl;
        server_name  bcp.oasishospital.org;

        ssl_certificate      C:/nginx-1.29.1/SSL/server.crt;
        ssl_certificate_key  C:/nginx-1.29.1/SSL/server.key;

        ssl_session_cache    shared:SSL:1m;
        ssl_session_timeout  5m;

        ssl_ciphers  HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers  on;

        location / {
            proxy_pass         http://10.10.130.190:8080;  # <-- Updated port here
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }
    }
}



